{
  "name": "project-notes-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/run-electron.cjs",
    "app:windows": "node scripts/run-electron.cjs",
    "electron:build": "tsc && vite build && electron-builder --win nsis",
    "sync:server": "node scripts/sync-server.cjs",
    "cap:add": "cap add android",
    "cap:sync": "tsc && vite build && cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.1",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "diff": "^7.0.0",
    "html-to-image": "^1.11.11",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.475.0",
    "marked": "^15.0.7",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.1",
    "@types/diff": "^5.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "build": {
    "appId": "top.rduteam.projectnote",
    "productName": "项目便签",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "icon.ico",
      "icon.png"
    ],
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    }
  }
}
